#!/usr/bin/env bash
set -euo pipefail

stack_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
state_dir="$stack_dir/model-selection"
state_file="$state_dir/selected.env"
startup_state_file="$state_dir/lmstudio-startup.env"
project_swap_path="$stack_dir/.modelctl.swap"
project_swap_total_bytes=$((128 * 1024 * 1024 * 1024))

usage() {
  cat >&2 <<'EOF'
Usage:
  ./modelctl use <chutes|openrouter|local> <model-id>
  ./modelctl use-local-coding
  ./modelctl use-local-coding-quality
  ./modelctl current
  ./modelctl list [chutes|openrouter] [count|all]
  ./modelctl local list
  ./modelctl local stop

Examples:
  ./modelctl use chutes deepseek-ai/DeepSeek-V3.2-TEE
  ./modelctl use openrouter tencent/hy3:free
  ./modelctl use local openai/gpt-oss-20b
  ./modelctl use-local-coding
  ./modelctl use-local-coding-quality
  ./modelctl list
  ./modelctl list chutes all
EOF
  exit 2
}

validate_provider() {
  case "$1" in
    chutes|openrouter|local) ;;
    *) echo "Unknown provider: $1" >&2; exit 2 ;;
  esac
}

validate_model() {
  case "$1" in
    ''|*[!A-Za-z0-9._:/@+-]*)
      echo "Model IDs may only contain letters, digits, '.', '_', ':', '/', '@', '+', and '-'." >&2
      exit 2
      ;;
  esac
}

write_state() {
  local provider="$1"
  local model="$2"
  local temporary_file

  if [[ ! -d "$state_dir" ]]; then
    install -d -m 0755 "$state_dir"
  fi
  temporary_file=$(mktemp "$state_dir/.selected.env.XXXXXX")
  printf 'MODEL_PROVIDER=%s\nMODEL_ID=%s\n' "$provider" "$model" > "$temporary_file"
  chmod 0644 "$temporary_file"
  mv "$temporary_file" "$state_file"
}

write_lmstudio_startup() {
  local preset="$1"
  local model="$2"
  local download_spec="$3"
  local load_key="$4"
  local model_path="$5"
  local context_window="$6"
  local gpu_offload="$7"
  local temporary_file

  install -d -m 0755 "$state_dir"
  temporary_file=$(mktemp "$state_dir/.lmstudio-startup.env.XXXXXX")
  printf 'PRESET=%s\nMODEL_ID=%s\nDOWNLOAD_SPEC=%s\nLOAD_KEY=%s\nMODEL_PATH=%s\nCONTEXT_WINDOW=%s\nGPU_OFFLOAD=%s\n' \
    "$preset" "$model" "$download_spec" "$load_key" "$model_path" "$context_window" "$gpu_offload" \
    > "$temporary_file"
  chmod 0644 "$temporary_file"
  mv "$temporary_file" "$startup_state_file"
}

wait_for_local_model() {
  local container_id initial_restart_count models_json restart_count status

  container_id=$(docker compose ps -a -q lmstudio)
  if [[ -z "$container_id" ]]; then
    echo "The LM Studio container does not exist." >&2
    return 1
  fi
  initial_restart_count=$(docker inspect --format '{{.RestartCount}}' "$container_id")

  for _ in $(seq 1 900); do
    status=$(docker inspect --format '{{.State.Status}}' "$container_id")
    restart_count=$(docker inspect --format '{{.RestartCount}}' "$container_id")
    if [[ "$status" == exited || "$status" == dead || "$restart_count" != "$initial_restart_count" ]]; then
      docker compose logs --tail 120 lmstudio >&2 || true
      echo "The LM Studio process exited while loading the selected model." >&2
      return 1
    fi
    if models_json=$(curl -fsS --max-time 2 http://127.0.0.1:1234/v1/models 2>/dev/null) \
      && jq -e '.data | any(.id == "local/model")' <<<"$models_json" >/dev/null; then
      return
    fi
    sleep 1
  done

  docker compose logs --tail 120 lmstudio >&2 || true
  echo "The selected local model did not become ready within 15 minutes." >&2
  return 1
}

verify_quality_model() {
  local available_kib props_json

  props_json=$(curl -fsS --max-time 10 http://127.0.0.1:1234/props)
  jq -e '
    .default_generation_settings.n_ctx == 32768
      and .total_slots == 1
      and .model_alias == "local/model"
      and .model_path == "/root/.lmstudio/models/ggml-org/gpt-oss-120b-GGUF/gpt-oss-120b-MXFP4.gguf"
      and .modalities.vision == false
  ' <<<"$props_json" >/dev/null

  available_kib=$(awk '/^MemAvailable:/ { print $2; exit }' /proc/meminfo)
  if (( available_kib < 2 * 1024 * 1024 )); then
    echo "gpt-oss-120b left less than 2 GiB of available system memory." >&2
    return 1
  fi
  if nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits \
    | awk '$1 < 512 { insufficient = 1 } END { exit insufficient }'; then
    return
  fi
  echo "gpt-oss-120b left less than 512 MiB free on at least one GPU." >&2
  return 1
}

project_swap_is_active() {
  awk -v path="$project_swap_path" 'NR > 1 && $1 == path { found = 1 } END { exit !found }' /proc/swaps
}

disable_project_swap() {
  if project_swap_is_active; then
    sudo swapoff "$project_swap_path"
  fi
}

enable_project_swap() {
  local available_bytes current_bytes desired_file_bytes desired_usable_bytes
  local filesystem_type memtotal_bytes memtotal_kib page_bytes required_bytes
  local safety_bytes swap_type

  memtotal_kib=$(awk '/^MemTotal:/ { print $2; exit }' /proc/meminfo)
  case "$memtotal_kib" in
    ''|*[!0-9]*) echo "Could not determine physical memory size." >&2; exit 1 ;;
  esac
  memtotal_bytes=$((memtotal_kib * 1024))
  if (( memtotal_bytes >= project_swap_total_bytes )); then
    return
  fi

  page_bytes=$(getconf PAGESIZE)
  desired_usable_bytes=$((project_swap_total_bytes - memtotal_bytes))
  desired_file_bytes=$((desired_usable_bytes + page_bytes))
  filesystem_type=$(findmnt --noheadings --output FSTYPE --target "$stack_dir")
  if [[ "$filesystem_type" != ext4 ]]; then
    echo "The managed swap file requires ext4; $stack_dir is on $filesystem_type." >&2
    exit 1
  fi
  if [[ -L "$project_swap_path" || (-e "$project_swap_path" && ! -f "$project_swap_path") ]]; then
    echo "$project_swap_path must be a regular file." >&2
    exit 1
  fi

  current_bytes=0
  if [[ -e "$project_swap_path" ]]; then
    current_bytes=$(stat --format=%s "$project_swap_path")
  fi
  if (( current_bytes != desired_file_bytes )); then
    if project_swap_is_active; then
      sudo swapoff "$project_swap_path"
    fi
    required_bytes=$((desired_file_bytes - current_bytes))
    if (( required_bytes < 0 )); then
      required_bytes=0
    fi
    available_bytes=$(df --block-size=1 --output=avail "$stack_dir" | awk 'NR == 2 { print $1 }')
    safety_bytes=$((1024 * 1024 * 1024))
    if (( available_bytes < required_bytes + safety_bytes )); then
      echo "Insufficient disk space for $project_swap_path; need the growth plus 1 GiB free." >&2
      exit 1
    fi
    sudo fallocate --length "$desired_file_bytes" "$project_swap_path"
    sudo chmod 0600 "$project_swap_path"
    sudo mkswap --force "$project_swap_path" >/dev/null
  else
    sudo chmod 0600 "$project_swap_path"
    if ! project_swap_is_active; then
      swap_type=$(sudo blkid --probe --output value --match-tag TYPE "$project_swap_path" 2>/dev/null || true)
      if [[ "$swap_type" != swap ]]; then
        sudo mkswap --force "$project_swap_path" >/dev/null
      fi
    fi
  fi

  if ! project_swap_is_active; then
    sudo swapon --priority 10 "$project_swap_path"
  fi
}

stop_local_model() {
  local instance ps_json
  local -a loaded_instances

  if [[ -n "$(docker compose ps -a -q lmstudio)" ]]; then
    if ps_json=$(docker compose exec -T lmstudio lms ps --json 2>/dev/null); then
      mapfile -t loaded_instances < <(jq -r '.[] | select(.type == "llm") | .identifier' <<<"$ps_json")
      for instance in "${loaded_instances[@]}"; do
        docker compose exec -T lmstudio lms unload "$instance" || true
      done
    fi
    docker compose --profile local stop lmstudio
  fi
  disable_project_swap
  echo "Local LLM service stopped; project-managed swap is disabled."
}

select_local_model() {
  local model="$1"
  local context_window="${LOCAL_CONTEXT_WINDOW:-65536}"
  local gpu_offload="${LOCAL_GPU_OFFLOAD:-}"

  case "$context_window" in
    ''|*[!0-9]*) echo "LOCAL_CONTEXT_WINDOW must be a positive integer." >&2; return 2 ;;
  esac
  if (( context_window < 1 )); then
    echo "LOCAL_CONTEXT_WINDOW must be a positive integer." >&2
    return 2
  fi

  write_lmstudio_startup managed "$model" "$model" "$model" '' "$context_window" "$gpu_offload"
  docker compose --profile local up -d --force-recreate lmstudio
  wait_for_local_model
  disable_project_swap
}

select_local_coding_model() {
  local model='lmstudio-community/gpt-oss-20b-GGUF'
  local download_spec='https://huggingface.co/lmstudio-community/gpt-oss-20b-GGUF@mxfp4'
  local model_path='/root/.lmstudio/models/lmstudio-community/gpt-oss-20b-GGUF/gpt-oss-20b-MXFP4.gguf'

  export COMPOSE_FILE="$stack_dir/docker-compose.yml:$stack_dir/docker-compose.nvidia.yml"
  export LOCAL_CONTEXT_WINDOW=32768
  export LOCAL_GPU_OFFLOAD=max

  write_lmstudio_startup managed "$model" "$download_spec" gpt-oss-20b "$model_path" 32768 max
  docker compose --profile local up -d --force-recreate lmstudio
  wait_for_local_model
  disable_project_swap
  write_state local "$model"
  apply_to_running_agents
  printf 'Selected local/%s for new Codex and Claude sessions.\n' "$model"
}

select_local_coding_quality_model() (
  local model='ggml-org/gpt-oss-120b-GGUF'
  local download_spec='https://huggingface.co/ggml-org/gpt-oss-120b-GGUF@mxfp4'
  local model_path='/root/.lmstudio/models/ggml-org/gpt-oss-120b-GGUF/gpt-oss-120b-MXFP4.gguf'
  local selection_complete=false

  cleanup_quality_selection() {
    local status=$?

    trap - EXIT INT TERM
    if [[ "$selection_complete" != true ]]; then
      set +e
      docker compose --profile local stop lmstudio >/dev/null 2>&1
      disable_project_swap
    fi
    exit "$status"
  }

  trap cleanup_quality_selection EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  enable_project_swap
  export COMPOSE_FILE="$stack_dir/docker-compose.yml:$stack_dir/docker-compose.nvidia.yml"
  export LOCAL_CONTEXT_WINDOW=32768
  export LOCAL_GPU_OFFLOAD=6

  write_lmstudio_startup quality "$model" "$download_spec" gpt-oss-120b "$model_path" 32768 6
  docker compose --profile local up -d --force-recreate lmstudio
  wait_for_local_model
  verify_quality_model
  write_state local "$model"
  apply_to_running_agents
  selection_complete=true
  printf 'Selected local/%s for new Codex and Claude sessions.\n' "$model"
)

apply_to_running_agents() {
  local service

  for service in workspace codex claude-code; do
    if [[ -n "$(docker compose ps -q "$service")" ]]; then
      docker compose exec -T "$service" modelctl apply
    fi
  done
}

parse_list_count() {
  local requested_count="${1:-default}"

  model_list_max_total=1

  case "$requested_count" in
    default)
      model_list_limit=99999
      model_list_heading='Models'
      ;;
    all)
      model_list_limit=99999
      model_list_max_total=null
      model_list_heading='All'
      ;;
    *[!0-9]*|'')
      echo "Count must be a positive integer or 'all'." >&2
      exit 2
      ;;
    *)
      model_list_limit=$((10#$requested_count))
      if (( model_list_limit < 1 )); then
        echo "Count must be greater than zero." >&2
        exit 2
      fi
      model_list_heading="Top $model_list_limit"
      ;;
  esac
}

fetch_openrouter_models() {
  curl --fail --silent --show-error --location --max-time 30 \
    'https://openrouter.ai/api/v1/models?category=programming&sort=coding-high-to-low' \
    | jq '
      def clean_size:
        gsub("\\s+"; "") | ascii_upcase;
      def name_size:
        try (capture("(?i)(?<size>[0-9]+(?:\\.[0-9]+)?\\s*[BMTP])").size | clean_size) catch null;
      def parameter_size:
        (try (capture("(?i)(?<size>[0-9]+(?:\\.[0-9]+)?\\s*[BMTP])\\s+total(?:\\s+parameters?)?").size | clean_size) catch null)
        // (try (capture("(?i)(?<size>[0-9]+(?:\\.[0-9]+)?\\s*[BMTP])\\s+parameters?").size | clean_size) catch null);
      [.data
      | to_entries[]
      | {
          rank: (.key + 1),
          provider: "OpenRouter",
          model: .value.id,
          size: ((.value.name | name_size) // ((.value.description // "") | parameter_size) // "n/a"),
          input: ((.value.pricing.prompt // "0") | tonumber * 1000000),
          output: ((.value.pricing.completion // "0") | tonumber * 1000000)
        }]
    '
}

fetch_chutes_models() {
  curl --fail --silent --show-error --location --max-time 30 \
    'https://chutes.ai/api/models?type=llm&sort=popularity&limit=100' \
    | jq '
      def clean_size:
        gsub("\\s+"; "") | ascii_upcase;
      def name_size:
        try (capture("(?i)(?<size>[0-9]+(?:\\.[0-9]+)?\\s*[BMTP])").size | clean_size) catch null;
      def parameter_size:
        (try (capture("(?i)(?<size>[0-9]+(?:\\.[0-9]+)?\\s*[BMTP])\\s+total(?:\\s+parameters?)?").size | clean_size) catch null)
        // (try (capture("(?i)(?<size>[0-9]+(?:\\.[0-9]+)?\\s*[BMTP])\\s+parameters?").size | clean_size) catch null);
      [.items
      | to_entries[]
      | {
          rank: (.key + 1),
          provider: "Chutes",
          model: .value.name,
          size: ((.value.name | name_size) // ((.value.tagline // "") | parameter_size) // "n/a"),
          input: .value.pricing.input_per_million,
          output: .value.pricing.output_per_million
        }]
    '
}

parse_list_arguments() {
  model_list_provider=all

  case $# in
    0)
      parse_list_count default
      ;;
    1)
      case "$1" in
        chutes|openrouter)
          model_list_provider="$1"
          parse_list_count default
          ;;
        local)
          echo "Local models are not listed because their pricing is host-specific." >&2
          exit 2
          ;;
        *) parse_list_count "$1" ;;
      esac
      ;;
    2)
      case "$1" in
        chutes|openrouter)
          model_list_provider="$1"
          parse_list_count "$2"
          ;;
        local)
          echo "Local models are not listed because their pricing is host-specific." >&2
          exit 2
          ;;
        *) echo "Unknown list provider: $1" >&2; exit 2 ;;
      esac
      ;;
    *) usage ;;
  esac
}

list_models() {
  local temporary_dir chutes_process openrouter_process provider_label status

  parse_list_arguments "$@"
  temporary_dir=$(mktemp -d)

  case "$model_list_provider" in
    all)
      fetch_chutes_models > "$temporary_dir/chutes.json" &
      chutes_process=$!
      fetch_openrouter_models > "$temporary_dir/openrouter.json" &
      openrouter_process=$!
      status=0
      if ! wait "$chutes_process"; then status=1; fi
      if ! wait "$openrouter_process"; then status=1; fi
      if (( status != 0 )); then
        rm -rf "$temporary_dir"
        return 1
      fi
      jq -s 'add' "$temporary_dir/chutes.json" "$temporary_dir/openrouter.json" > "$temporary_dir/models.json"
      ;;
    chutes)
      fetch_chutes_models > "$temporary_dir/models.json"
      ;;
    openrouter)
      fetch_openrouter_models > "$temporary_dir/models.json"
      ;;
  esac

  case "$model_list_provider" in
    all) provider_label='all providers' ;;
    chutes) provider_label='Chutes' ;;
    openrouter) provider_label='OpenRouter' ;;
  esac
  if [[ "$model_list_max_total" == null ]]; then
    printf '%s models from %s, sorted by total token price (lowest first)\n' "$model_list_heading" "$provider_label"
  else
    printf '%s from %s with total token price up to $1 / 1M, sorted lowest first\n' "$model_list_heading" "$provider_label"
  fi
  printf '%-12s %-6s %-48s %-12s %14s %14s %14s\n' 'Provider' 'Rank' 'Model ID' 'Parameters' 'Input / 1M' 'Output / 1M' 'Total / 1M'
  status=0
  jq -r --argjson limit "$model_list_limit" --argjson max_total "$model_list_max_total" '
    def usd_per_million:
      if . == 0 then "free" else "$\((. * 10000 | round / 10000))" end;
    sort_by([(.input + .output), .input, .output, .provider, .model])
    | if $max_total == null then . else map(select((.input + .output) <= $max_total)) end
    | .[:$limit]
    | .[]
    | [.provider, .rank, .model, .size, (.input | usd_per_million), (.output | usd_per_million), ((.input + .output) | usd_per_million)]
    | @tsv
  ' "$temporary_dir/models.json" \
    | while IFS=$'\t' read -r provider rank model size input_price output_price total_price; do
        printf '%-12s %-6s %-48s %-12s %14s %14s %14s\n' "$provider" "$rank" "$model" "$size" "$input_price" "$output_price" "$total_price"
      done || status=1
  rm -rf "$temporary_dir"
  return "$status"
}

case "${1:-}" in
  use-local-coding-quality)
    [[ $# -eq 1 ]] || usage
    select_local_coding_quality_model
    ;;
  use-local-coding)
    [[ $# -eq 1 ]] || usage
    select_local_coding_model
    ;;
  use)
    [[ $# -eq 3 ]] || usage
    provider="$2"
    model="$3"
    validate_provider "$provider"
    validate_model "$model"
    if [[ "$provider" == local ]]; then
      select_local_model "$model"
    fi
    write_state "$provider" "$model"
    apply_to_running_agents
    printf 'Selected %s/%s for new Codex and Claude sessions.\n' "$provider" "$model"
    ;;
  current)
    if [[ -r "$state_file" ]]; then
      cat "$state_file"
    else
      printf 'No model has been selected yet.\n'
    fi
    ;;
  list)
    list_models "${@:2}"
    ;;
  local)
    [[ $# -eq 2 ]] || usage
    if [[ "$2" == stop ]]; then
      stop_local_model
      exit
    fi
    [[ "$2" == list ]] || usage
    if [[ -z "$(docker compose ps -q lmstudio)" ]]; then
      echo "LM Studio is not running. Start it with: docker compose --profile local up -d lmstudio" >&2
      exit 1
    fi
    docker compose exec -T lmstudio lms ls
    ;;
  *) usage ;;
esac

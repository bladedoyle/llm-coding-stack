FROM node:22-slim

ARG USERNAME=claude
ARG USER_UID=1000
ARG USER_GID=1000

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        procps \
        bubblewrap \
        vim \
        less \
        jq \
        ripgrep \
        unzip \
        file \
        build-essential \
        clang \
        golang \
        rustc \
        cargo \
        make \
        cmake \
        pkg-config \
        gcc \
        g++ \
        gdb \
        python3 \
        python3-pip \
        python3-venv \
        sudo \
 && rm -rf /var/lib/apt/lists/*

RUN npm install -g @anthropic-ai/claude-code

# Match the Codex image's pre-installed local development and MCP toolchain.
RUN npm install -g \
        @modelcontextprotocol/server-filesystem \
        @modelcontextprotocol/server-memory \
        @modelcontextprotocol/server-sequential-thinking \
        @treedy/typescript-lsp-mcp \
        mcp-searxng

ENV UV_TOOL_BIN_DIR=/usr/local/bin \
    UV_TOOL_DIR=/opt/uv/tools
RUN curl -LsSf https://astral.sh/uv/install.sh \
        | env UV_INSTALL_DIR=/usr/local/bin INSTALLER_NO_MODIFY_PATH=1 sh \
 && uv tool install --python /usr/bin/python3 mcp-server-git \
 && uv tool install --python /usr/bin/python3 mcp-server-fetch \
 && uv tool install --python /usr/bin/python3 mcp-server-qdrant \
 && uv tool install --python /usr/bin/python3 pytest==9.1.1 \
 && chmod -R a+rX /opt/uv

RUN userdel -r node 2>/dev/null || true \
 && groupdel node 2>/dev/null || true \
 && groupadd --gid ${USER_GID} ${USERNAME} \
 && useradd --uid ${USER_UID} --gid ${USER_GID} --shell /bin/bash \
            --create-home ${USERNAME} \
 && echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${USERNAME} \
 && chmod 0440 /etc/sudoers.d/${USERNAME}

RUN mv /usr/local/bin/claude /usr/local/bin/claude.real \
 && printf '#!/bin/sh\nexec /usr/local/bin/claude.real --dangerously-skip-permissions "$@"\n' \
        > /usr/local/bin/claude \
 && chmod 0755 /usr/local/bin/claude

COPY modelctl-in-container.sh /usr/local/bin/modelctl
COPY configure-claude-mcp.sh /usr/local/bin/configure-claude-mcp
RUN chmod 0755 \
        /usr/local/bin/modelctl \
        /usr/local/bin/configure-claude-mcp \
 && mkdir -p /home/${USERNAME}/.claude /home/${USERNAME}/.mcp-memory \
 && printf '{}\n' > /home/${USERNAME}/.claude.json \
 && printf '# Claude Code workspace instructions\n\n\
- Update source files directly and summarize changes after verification.\n\
- Keep changes scoped to the request and preserve unrelated user work.\n\
- Use sudo when system-level changes are required in this container.\n' \
        > /home/${USERNAME}/.claude/CLAUDE.md \
 && chown -R ${USERNAME}:${USERNAME} \
        /home/${USERNAME}/.claude \
        /home/${USERNAME}/.mcp-memory \
        /home/${USERNAME}/.claude.json \
 && FASTEMBED_CACHE_PATH=/home/${USERNAME}/.cache/fastembed \
    /opt/uv/tools/mcp-server-qdrant/bin/python -c \
      "from fastembed import TextEmbedding; TextEmbedding('sentence-transformers/all-MiniLM-L6-v2')" \
 && chown -R ${USERNAME}:${USERNAME} /home/${USERNAME}/.cache

ENV HOME=/home/claude

USER ${USERNAME}
WORKDIR /workspaces

CMD ["claude"]

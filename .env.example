# Copy this file to .env and customize the stack.
# `.env` is ignored by git and is loaded by Docker Compose automatically.

# Default model used before you run ./modelctl use. Model selection is stored
# under model-selection/ and applies to new Codex and Claude sessions.
DEFAULT_MODEL_PROVIDER=chutes
DEFAULT_MODEL=deepseek-ai/DeepSeek-V3.2-TEE

# OpenRouter Configuration
OPENROUTER_API_KEY=sk-or-v1-replace_me

# Chutes Configuration
CHUTES_API_KEY=cpk_replace_me

# Hugging Face Configuration
HF_TOKEN=hf_replace_me

# Local Model Configuration. The local service is disabled by default and is
# started automatically by ./modelctl use local <model-id>.
LOCAL_CONTEXT_WINDOW=65536
# Leave blank to let LM Studio choose CPU or GPU automatically. Set this to
# max, off, or a value from 0 to 1 to override that choice.
LOCAL_GPU_OFFLOAD=

# LiteLLM gateway logging: off, debug, or detailed. Detailed logs can include
# prompts, source code, and tool output.
LITELLM_DEBUG_MODE=debug

# Copy to .env and replace the placeholder with the API key from Chutes.
# `.env` is ignored by git and is loaded by Docker Compose automatically.
CHUTES_API_KEY=cpk_replace_me
OPENROUTER_API_KEY=sk-or-v1-replace_me
# OpenRouter model ID, without LiteLLM's openrouter/ provider prefix.
OPENROUTER_MODEL=tencent/hy3:free

# Pin Chutes requests to the DeepSeek coding model.
CHUTES_MODEL=deepseek-ai/DeepSeek-V3.2-TEE

# Codex compacts before this many tokens. Keep below the model's 163,840-token
# maximum to leave room for tool calls and output.
CHUTES_CONTEXT_WINDOW=65536

# Shared default used by the VS Code plugin, Codex CLI, and Claude Code CLI:
# `chutes`, `local` (LM Studio's openai/gpt-oss-20b), or `openrouter`.
LLM_PROVIDER=chutes
LOCAL_CONTEXT_WINDOW=65536
OPENROUTER_CONTEXT_WINDOW=98304

# LiteLLM gateway logging: off, debug, or detailed. Detailed logs can include
# prompts, source code, and tool output.
LITELLM_DEBUG_MODE=detailed

# User projects mounted into workspace container (not part of the stack config)
workspaces/*
!workspaces/.gitkeep

# Editor artifacts
*.swp
*.swo
*~

# Python
__pycache__/
*.py[cod]
.env
venv/
.venv/

# Runtime model selection shared by the agent containers.
model-selection/*
!model-selection/.gitkeep

# Host-managed swap used by large local coding models.
.modelctl.swap

# Logs
*.log

# Local model research notes
MODELS.md
MODELS_RAM.md

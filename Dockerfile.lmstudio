FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV LMS_SERVER_HOST=0.0.0.0
ENV LMS_SERVER_PORT=1234
ENV PATH="/root/.lmstudio/bin:/root/.local/bin:${PATH}"

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        procps \
        xz-utils \
        libatomic1 \
        libgomp1 \
 && rm -rf /var/lib/apt/lists/*

# Installs llmster and the lms CLI for headless LM Studio operation.
RUN curl -fsSL https://lmstudio.ai/install.sh | bash

EXPOSE 1234

# The selector loads the active coding model with the stable local/model
# identifier after the service has started.
ENV LMS_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# Startup sequence:
#  1. Start daemon + server.
#  2. Pull and load the embedding model.
#  3. Stream logs so the container stays alive.
CMD ["bash", "-lc", "\
  lms daemon up && \
  lms server start --bind ${LMS_SERVER_HOST} --port ${LMS_SERVER_PORT} && \
  (lms get ${LMS_EMBEDDING_MODEL} --yes || true) && \
  (lms load ${LMS_EMBEDDING_MODEL} -y || true) && \
  lms log stream"]

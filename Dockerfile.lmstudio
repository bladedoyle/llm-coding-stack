FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV LMS_SERVER_HOST=0.0.0.0
ENV LMS_SERVER_PORT=1234
ENV PATH="/root/.lmstudio/bin:/root/.local/bin:${PATH}"

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        procps \
        xz-utils \
        libatomic1 \
        libgomp1 \
 && rm -rf /var/lib/apt/lists/*

# Installs llmster and the lms CLI for headless LM Studio operation.
RUN curl -fsSL https://lmstudio.ai/install.sh | bash

EXPOSE 1234

# When the local provider is selected, preload the configured coding model with
# a stable API identifier and a single concurrent prediction.
ENV LMS_MODEL_IDENTIFIER=local/model
ENV LMS_DEFAULT_PARALLEL=1
ENV LMS_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# Startup sequence:
#  1. Start daemon + server.
#  2. If LLM_PROVIDER=local, pull and load the chat model.
#  3. Pull and load the embedding model.
#  4. Stream logs so the container stays alive.
CMD ["bash", "-lc", "\
  lms daemon up && \
  lms server start --bind ${LMS_SERVER_HOST} --port ${LMS_SERVER_PORT} && \
  if [ \"${LLM_PROVIDER}\" = \"local\" ]; then \
    : \"${LOCAL_MODEL:?LOCAL_MODEL must be set when LLM_PROVIDER=local}\" && \
    (lms get ${LOCAL_MODEL} --yes || true) && \
    (for i in 1 2 3 4 5 6; do \
       lms load ${LOCAL_MODEL} --identifier ${LMS_MODEL_IDENTIFIER} -c ${LOCAL_CONTEXT_WINDOW} --parallel ${LMS_DEFAULT_PARALLEL} --gpu max -y && break; \
       echo \"chat model load failed, retry $i\"; sleep 5; \
     done); \
  else \
    echo \"Skipping local LLM download and load because LLM_PROVIDER=${LLM_PROVIDER}\"; \
  fi && \
  (lms get ${LMS_EMBEDDING_MODEL} --yes || true) && \
  (lms load ${LMS_EMBEDDING_MODEL} --gpu max -y || true) && \
  lms log stream"]

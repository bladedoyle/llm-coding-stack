FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV LMS_SERVER_HOST=0.0.0.0
ENV LMS_SERVER_PORT=1234
ENV PATH="/root/.lmstudio/bin:/root/.local/bin:${PATH}"

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        procps \
        xz-utils \
        libatomic1 \
        libgomp1 \
 && rm -rf /var/lib/apt/lists/*

# Installs llmster and the lms CLI for headless LM Studio operation.
RUN curl -fsSL https://lmstudio.ai/install.sh | bash

EXPOSE 1234

COPY lmstudio-entrypoint.sh /usr/local/bin/lmstudio-entrypoint

RUN chmod 0755 /usr/local/bin/lmstudio-entrypoint

CMD ["lmstudio-entrypoint"]
